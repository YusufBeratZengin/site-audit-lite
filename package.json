{
  "name": "site-audit-lite",
  "version": "0.1.0",
  "description": "A fast, zero-dependency website health checker for small business sites: SEO, accessibility, security headers, performance hints and broken links",
  "type": "module",
  "bin": {
    "site-audit": "bin/site-audit.js"
  },
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js"
  },
  "files": [
    "bin",
    "src",
    "README.md",
    "README.tr.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --experimental-test-coverage --test",
    "test:coverage": "node --experimental-test-coverage --test-coverage-include=src/** --test-coverage-include=bin/** --test-coverage-lines=85 --test",
    "lint": "eslint .",
    "prepublishOnly": "npm run lint && npm test"
  },
  "keywords": [
    "seo",
    "accessibility",
    "security-headers",
    "broken-links",
    "audit",
    "cli"
  ],
  "author": "Yusuf Berat Zengin",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YusufBeratZengin/site-audit-lite.git"
  },
  "bugs": {
    "url": "https://github.com/YusufBeratZengin/site-audit-lite/issues"
  },
  "homepage": "https://github.com/YusufBeratZengin/site-audit-lite#readme",
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
